<%- include('partials/header', { title: 'Login' }) %>

<div class="container my-5" style="max-width:440px;">
  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <h3 class="mb-1 text-center">Welcome Back</h3>
      <p class="text-muted text-center small mb-4">Log in to your account</p>

      <form action="/login" method="POST">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required>
        </div>
        <button class="btn btn-primary w-100">Login</button>
      </form>

      <p class="text-center mt-3 mb-0 small">
        No account? <a href="/register">Register</a>
      </p>

      <div class="alert alert-light border mt-3 mb-0 small">
        <strong>Admin login:</strong><br>
        admin@carental.com / admin123
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>