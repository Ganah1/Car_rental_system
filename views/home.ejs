<%- include('partials/header', { title: 'Home' }) %>

<section class="bg-primary text-white py-5 mb-4">
  <div class="container text-center">
    <h1 class="display-5 fw-bold">Find Your Perfect Ride</h1>
    <p class="lead">Premium cars at affordable prices</p>
    <form class="row g-2 justify-content-center mt-3" action="/" method="GET">
      <div class="col-md-5">
        <input type="text" name="search" class="form-control form-control-lg"
               placeholder="Search by name or model..." value="<%= search %>">
      </div>
      <div class="col-auto">
        <button class="btn btn-warning btn-lg"><i class="bi bi-search"></i> Search</button>
      </div>
      <% if (search) { %>
        <div class="col-auto">
          <a href="/" class="btn btn-outline-light btn-lg">Clear</a>
        </div>
      <% } %>
    </form>
  </div>
</section>

<div class="container">
  <h2 class="mb-4">Available Cars <span class="text-muted fs-6">(<%= cars.length %>)</span></h2>

  <% if (cars.length === 0) { %>
    <div class="alert alert-info">No cars found matching your search.</div>
  <% } %>

  <div class="row g-4">
    <% cars.forEach(car => { %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
          <img src="<%= car.image %>" class="card-img-top" alt="<%= car.name %>"
               style="height:200px;object-fit:cover;"
               onerror="this.src='https://via.placeholder.com/400x200?text=Car'">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start">
              <h5 class="card-title mb-1"><%= car.name %></h5>
              <span class="badge bg-success">Available</span>
            </div>
            <p class="text-muted small mb-2"><%= car.model %> • <%= car.year %></p>
            <p class="card-text small flex-grow-1"><%= car.description %></p>
            <div class="mb-2">
              <span class="badge bg-secondary"><i class="bi bi-people"></i> <%= car.seats %> seats</span>
              <span class="badge bg-secondary"><i class="bi bi-gear"></i> <%= car.transmission %></span>
              <span class="badge bg-secondary"><i class="bi bi-fuel-pump"></i> <%= car.fuel %></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <strong class="text-primary fs-5">$<%= Number(car.price_per_day).toFixed(2) %>/day</strong>
              <a href="/cars/<%= car.id %>" class="btn btn-primary btn-sm">View Details</a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>